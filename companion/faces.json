  "eye": {"dx": 0.232, "v": 0.585},
  "mouth": {"u": 0.5, "v": 0.325},
  "blinking": {"eyes": "line", "open": ["oval", "big", "up", "left", "right"],
               "note": "a blink swaps open eyes for a line for about an eighth of a second and keeps the mouth; eyes that are drawn shut or as a shape (caret, arc, heart ...) do not blink"},

